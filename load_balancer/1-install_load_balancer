#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to distribute traffic to web-01 and web-02

apt-get update
apt-get install -y haproxy

echo "ENABLED=1" > /etc/default/haproxy

cat << 'EOF' > /etc/haproxy/haproxy.cfg
global
	log /dev/log	local0
	log /dev/log	local1 notice
	chroot /var/lib/haproxy
	stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
	stats timeout 30s
	user haproxy
	group haproxy
	daemon

defaults
	log	global
	mode	http
	option	httplog
	option	dontlognull
	timeout connect 5000
	timeout client  50000
	timeout server  50000

frontend http_front
	bind *:80
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7349-web-01 18.171.158.15:80 check
	server 7349-web-02 16.60.112.142:80 check
EOF

service haproxy restart
