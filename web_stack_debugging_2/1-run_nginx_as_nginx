cat << 'EOF' > 1-run_nginx_as_nginx
#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080.
sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/listen 80 default_server;/listen 8080 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/g' /etc/nginx/sites-available/default
chown -R nginx:nginx /var/log/nginx /var/lib/nginx /etc/nginx
touch /var/run/nginx.pid
chown nginx:nginx /var/run/nginx.pid
pkill -9 nginx
sudo -u nginx nginx
EOF

chmod +x 1-run_nginx_as_nginx
shellcheck 1-run_nginx_as_nginx
